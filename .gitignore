# =============================================================================
/android/.gradle/
/android/.idea/
/android/app/build/
/android/build/
/android/local.properties
/android/gradle.properties.local
/android/*.jks
/android/*.keystore
/android/keystore.properties
/android/gradle.properties.secret
/android/app/release/
/android/app/debug/
/android/app/*.apk
/android/app/*.aab
/android/app/*.ap_

